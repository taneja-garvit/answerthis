# Copy to `.env` in the repository root and fill in values.
# `.env` is gitignored. Never commit real credentials.

# --- Database (Neon PostgreSQL) -------------------------------------------
# Paste the connection string from the Neon console (Connection Details).
# Both `postgresql://...` and `postgresql+psycopg://...` forms are accepted;
# keep `sslmode=require` (Neon requires SSL).
DATABASE_URL=

# Isolated database for automated tests. MUST NOT point at DATABASE_URL.
# Recommended: a dedicated Neon branch (e.g. `test`) — see README.
# Tests fail with an explicit message if this is missing.
TEST_DATABASE_URL=

# Small pool: Neon is remote/serverless. Defaults are fine for the MVP.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_CONNECT_TIMEOUT_SECONDS=10

# --- AI provider -----------------------------------------------------------
# `deterministic` (default) needs no API key; it is used by tests and reproduces
# the seeded demo's fixture assessments. It does not assess arbitrary claims.
# `groq` (live) requires BOTH GROQ_API_KEY and LLM_MODEL (any Groq chat model
# that supports JSON mode, chosen by you — nothing is hard-coded).
LLM_PROVIDER=deterministic
GROQ_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
# Bounded retries, used both for 429/5xx/timeouts (with backoff) and for
# responses that fail JSON/schema validation.
LLM_MAX_RETRIES=2

# --- Academic metadata providers (used from Phase 3) -----------------------
# Optional. Crossref and OpenAlex give better service to requests that
# identify a contact address ("polite pool"). Leave blank to omit it.
CONTACT_EMAIL=
# Optional; OpenAlex works without a key for light use.
OPENALEX_API_KEY=
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=2
# Cached DOI metadata is reused for this many days before re-fetching.
PAPER_CACHE_TTL_DAYS=30

# --- API -------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
MAX_DRAFT_CHARS=20000
LOG_LEVEL=INFO
